# =============================================================================
# luatsutructuyen.net — Environment Variables
# =============================================================================
# Site:       luatsutructuyen.net (Phase 2 Scenario Funnel — VN only)
# Project:    Apolo Funnel Sites (Supabase project zxmdegfnjbvytjnwfhfq, Singapore)
# Schema:     ltt  (set in src/payload.config.ts via postgresAdapter({ schemaName: 'ltt' }))
# Password:   see PM_CREDENTIALS.md at workspace root
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Session Pooler URI (port 5432, host aws-1-ap-southeast-1.pooler.supabase.com)
# IPv4 compatible, supports prepared statements — single URI handles runtime AND `npx payload migrate`.
# Replace [PASSWORD] with the value from PM_CREDENTIALS.md.
DATABASE_URI=postgresql://postgres.zxmdegfnjbvytjnwfhfq:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- Payload ----------------------------------------------------------------
# Random 32+ character string. Generate with: openssl rand -hex 32
# Boot will hard-fail if missing or set to the literal placeholder.
PAYLOAD_SECRET=replace-with-32-plus-random-chars

# ---- Public site URL --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# ---- Supabase client (only if/when the public site uses Supabase JS SDK) ----
NEXT_PUBLIC_SUPABASE_URL=https://zxmdegfnjbvytjnwfhfq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# ---- Seed scripts (scripts/seed-admin.mjs, scripts/import-seo-content.mjs) --
SEED_ADMIN_EMAIL=admin@luatsutructuyen.net
SEED_ADMIN_PASSWORD=replace-with-strong-password

# ---- Contact Form Hub (tools/contact-form-hub) ------------------------------
# Google Apps Script Web App URL that aggregates contact submissions across all
# 21 sites into one Sheet. See PM_CREDENTIALS.md for the current URL.
# Fire-and-forget mirror; local Payload write is source of truth.
CONTACT_HUB_URL=

# ---- Cloudflare R2 — Media storage (@payloadcms/storage-s3) -----------------
# REQUIRED for admin/API image uploads to persist (serverless fs is ephemeral).
# Without R2_BUCKET the storage adapter disables itself and uploads fall back to
# local disk, which is LOST on every Vercel deploy. Mirror all six to Vercel env.
# Values are in PM_CREDENTIALS.md (shared bucket `apolowebsite`).
R2_BUCKET=apolowebsite
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-ebe397ad6fc946888f5c9aacc3cc48bb.r2.dev

# =============================================================================
# VERCEL DEPLOY NOTES
# - Set EVERY variable above in the Vercel project (Production + Preview).
# - DATABASE_URI + PAYLOAD_SECRET must also be available at BUILD time (the
#   homepage is statically generated and queries the DB during build).
# - Set NEXT_PUBLIC_SITE_URL to the production URL (https://luatsutructuyen.net).
# - After the first deploy, run the coordinated `npx payload migrate` against the
#   `ltt` schema (PM_INBOX handshake) — dev used push:true; production does not.
# =============================================================================
